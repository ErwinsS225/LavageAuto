# Dépendances
node_modules/
.npm/

# Build frontend (artefacts régénérables : ne pas versionner)
/dist/
frontend/dist/
frontend/.vite/
frontend/.smoke-dist/
*.tsbuildinfo

# Build backend
backend/backend
backend/bin/
backend/tmp/
washguard-api
*.exe

# Variables d'environnement (ne jamais committer de secrets)
# Tout ce qui commence par .env est ignoré — y compris les sauvegardes
# (.env.backup.*, .env.avant-maj) et les variantes par environnement
# (.env.local, .env.production…). Seul le gabarit reste versionné.
.env
.env.*
!.env.example
*.env.backup*

# Éditeurs / OS
.DS_Store
.idea/
.vscode/
*.swp

# Sauvegardes de base (contiennent des données clients : ne jamais committer)
backups/
*.sql.gz

# Captures et journaux produits par la recette (make recette, make rendu)
recette/
apercu/

# Divers
*.log
tmp/

# Exécutable produit par l’installation station (make build-station)
/washguard-api

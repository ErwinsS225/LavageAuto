# WashGuard — exemple de configuration.
#
# Copiez ce fichier en .env et renseignez les valeurs. Le .env est lu :
#   - par le backend Go (backend/config.go) au démarrage,
#   - par Vite au build du front (uniquement les variables préfixées VITE_).
# .env est ignoré par git : ne JAMAIS y mettre puis committer de vrais secrets.
# Contrôle avant démarrage : bash scripts/verifications/verifier-env.sh [dev|prod]

# --- Base de données (PostgreSQL, ex. Neon) -------------------------------
# NEON_DATABASE_URL est prioritaire sur DATABASE_URL (voir config.go).
NEON_DATABASE_URL=
DATABASE_URL=

# --- Serveur / API Go ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# development | production. En production, le seed vérifie ses garde-fous
# (données de démonstration désactivées, compte plateforme non créé).
APP_ENV=development
# Adresse publique de l'application (Clerk, liens, CORS).
APP_URL=
# En production HTTPS, mettre true pour le cookie de session « Secure ».
SESSION_COOKIE_SECURE=false
# lax (défaut) | strict | none (front sur un autre domaine, HTTPS obligatoire).
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=720
# Anti-abus : échecs de connexion tolérés par fenêtre, inscriptions par heure
# et par IP. Valeurs par défaut : 10 et 5.
AUTH_MAX_FAILURES=10
REGISTER_MAX_PER_HOUR=5
# Dossier de l'interface compilée (dist/). scripts/start.sh positionne
# STATIC_DIR=../dist automatiquement ; à laisser vide pour une API seule.
STATIC_DIR=
# Seed des données de démo au 1er démarrage. Mettre à false en production.
SEED_DEMO=true
# Origines autorisées par le CORS (liste séparée par des virgules). Vide = même origine.
CORS_ALLOWED_ORIGINS=

# --- Clerk (authentification, optionnel) ----------------------------------
# Laisser vide pour fonctionner en session applicative seule (login mot de passe).
CLERK_SECRET_KEY=
# Clé publique Clerk pour le front. Le front privilégie VITE_CLERK_PUBLISHABLE_KEY.
# Hôtes autorisés à servir l'interface de développement (aperçu distant,
# bac à sable…) : séparés par des virgules. Vide = seuls les hôtes locaux.
VITE_ALLOWED_HOSTS=

VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# URL JWKS Clerk. À défaut, déduite de la clé publique ou de NEXT_PUBLIC_CLERK_API_URL.
JWKS_URL_CLERK=
NEXT_PUBLIC_CLERK_API_URL=
CLERK_AUTHORIZED_PARTIES=
# Secret de signature des webhooks Clerk (pour la route dédiée).
CLERK_WEBHOOK_SIGNING_SECRET=
# Clé publique (PEM) affichée par Clerk, facultative : elle sert de repli pour
# vérifier les jetons quand l'adresse JWKS n'est pas joignable. L'URL JWKS
# reste prioritaire, car elle suit la rotation des clés.
# Exemple : JWKS_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
JWKS_PUBLIC_KEY=

# --- Compte plateforme de démonstration (hors production) ------------------
# Mot de passe du compte admin@washguard.app, créé au démarrage uniquement si
# APP_ENV n'est pas « production ». À changer même en développement.
PLATFORM_ADMIN_PASSWORD=admin1234

# --- Restes de l'ancien serveur Express (aucun code ne les lit) ------------
# Ces clés figuraient dans l'ancienne sauvegarde publiée. Le serveur Go ne les
# utilise pas : à renseigner seulement si vous reprenez le stockage de fichiers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL_S3=

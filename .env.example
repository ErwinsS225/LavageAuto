# WashGuard — exemple de configuration.
#
# Copiez ce fichier en .env et renseignez les valeurs. Le .env est lu :
#   - par le backend Go (backend/config.go) au démarrage,
#   - par Vite au build du front (uniquement les variables préfixées VITE_).
# .env est ignoré par git : ne JAMAIS y mettre puis committer de vrais secrets.

# --- Base de données (PostgreSQL, ex. Neon) -------------------------------
# NEON_DATABASE_URL est prioritaire sur DATABASE_URL (voir config.go).
NEON_DATABASE_URL=
DATABASE_URL=

# --- Serveur / API Go ------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
APP_ENV=development
# En production HTTPS, mettre true pour le cookie de session « Secure ».
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720
# Dossier de l'interface compilée (dist/). scripts/start.sh positionne
# STATIC_DIR=../dist automatiquement ; à laisser vide pour une API seule.
STATIC_DIR=
# Seed des données de démo au 1er démarrage. Mettre à false en production.
SEED_DEMO=true
# Origines autorisées par le CORS (liste séparée par des virgules). Vide = même origine.
CORS_ALLOWED_ORIGINS=

# --- Clerk (authentification, optionnel) ----------------------------------
# Laisser vide pour fonctionner en session applicative seule (login mot de passe).
CLERK_SECRET_KEY=
# Clé publique Clerk pour le front. Le front privilégie VITE_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# URL JWKS Clerk. À défaut, déduite de la clé publique ou de NEXT_PUBLIC_CLERK_API_URL.
JWKS_URL_CLERK=
NEXT_PUBLIC_CLERK_API_URL=
CLERK_AUTHORIZED_PARTIES=
# Secret de signature des webhooks Clerk (pour la route dédiée).
CLERK_WEBHOOK_SIGNING_SECRET=
